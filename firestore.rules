rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin'
      );
    }

    function isTeacherOrStaff() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'teacher' ||
        request.auth.token.role == 'supervisor'
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.role == 'student' && request.resource.data.minuteBalance == 100;
      allow update: if isOwner(userId) && 
        request.resource.data.role == resource.data.role && 
        request.resource.data.minuteBalance == resource.data.minuteBalance || isAdmin();
      allow delete: if isAdmin();
    }

    // Programs collection
    match /programs/{programId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Enrollments
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isTeacherOrStaff());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacherOrStaff();
    }

    // Packages & Pricing
    match /packages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Payment Requests (Top-ups)
    match /paymentRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isTeacherOrStaff());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isTeacherOrStaff();
    }

    // Credit Ledger (Financial Audit)
    match /creditLedger/{entryId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isTeacherOrStaff());
      allow write: if isAdmin(); // Handled primarily via Cloud Functions
    }

    // Groups & Messages
    match /groups/{groupId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.memberUids || isTeacherOrStaff());
      allow write: if isTeacherOrStaff();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids || isTeacherOrStaff());
      }
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isTeacherOrStaff();
    }

    // Audit Logs (Admin only)
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
